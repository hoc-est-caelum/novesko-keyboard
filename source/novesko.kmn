+ [SHIFT K_V] > 'В'
+ [SHIFT K_B] > 'Б'
+ [SHIFT K_N] > 'Н'
+ [SHIFT K_M] > 'М'

c AltGr + vowel = vowel with acute accent (stress mark, U+0301)
+ [RALT K_A] > 'а' U+0301
+ [RALT K_E] > 'е' U+0301
+ [RALT K_I] > 'и' U+0301
+ [RALT K_O] > 'о' U+0301
+ [RALT K_U] > 'у' U+0301

c AltGr + Shift + vowel = capital vowel with acute accent
+ [SHIFT RALT K_A] > 'А' U+0301
+ [SHIFT RALT K_E] > 'Е' U+0301
+ [SHIFT RALT K_I] > 'И' U+0301
+ [SHIFT RALT K_O] > 'О' U+0301
+ [SHIFT RALT K_U] > 'У' U+0301
