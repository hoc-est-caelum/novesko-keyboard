c Shift: Row 2
+ [SHIFT K_A] > 'А'
+ [SHIFT K_S] > 'С'
+ [SHIFT K_D] > 'Д'
+ [SHIFT K_F] > 'Ф'
+ [SHIFT K_G] > 'Г'
+ [SHIFT K_H] > 'Һ'
+ [SHIFT K_J] > 'Ж'
+ [SHIFT K_K] > 'К'
