+ [K_QUOTE] > 'ш'

c Row 3
+ [K_Z] > 'з'
+ [K_X] > 'х'
+ [K_C] > 'ц'
+ [K_V] > 'в'
+ [K_B] > 'б'
+ [K_N] > 'н'
+ [K_M] > 'м'

c Shift: Row 1
+ [SHIFT K_Q] > 'Џ'
+ [SHIFT K_W] > 'Ў'
+ [SHIFT K_E] > 'Е'
