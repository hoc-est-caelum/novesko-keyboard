c novesko generated from template at 2026-04-25 13:19:13
c with name "Novesko"
store(&VERSION) '15.0'
store(&NAME) 'Novesko'
store(&COPYRIGHT) 'Copyright © ego.sum.caelum@gmail.com'
store(&KEYBOARDVERSION) '1.1.0'
store(&LAYOUTFILE) 'novesko.keyman-touch-layout'
store(&TARGETS) 'any'

begin Unicode > use(main)

group(main) using keys

c ----------------------------------------------------------------
c Hardware (physical) keyboard: Novesko Cyrillic layout.
c Mirrors the touch layout rows:
c   џ ў е р т й у и о п ѕ   on  q w e r t y u i o p [
c   а с д ф г һ ж к л ч ш   on  a s d f g h j k l ; '
c   з х ц в б н м               on  z x c v b n m
c Digits and punctuation pass through from the underlying layout.
c ----------------------------------------------------------------

c Caps Lock acts like Shift on every letter key
store(&CasedKeys) [K_Q] [K_W] [K_E] [K_R] [K_T] [K_Y] [K_U] [K_I] [K_O] [K_P] [K_LBRKT] [K_A] [K_S] [K_D] [K_F] [K_G] [K_H] [K_J] [K_K] [K_L] [K_COLON] [K_QUOTE] [K_Z] [K_X] [K_C] [K_V] [K_B] [K_N] [K_M]

c Row 1
+ [K_Q] > 'џ'
+ [K_W] > 'ў'
+ [K_E] > 'е'
+ [K_R] > 'р'
+ [K_T] > 'т'
+ [K_Y] > 'й'
+ [K_U] > 'у'
+ [K_I] > 'и'
+ [K_O] > 'о'
+ [K_P] > 'п'
+ [K_LBRKT] > 'ѕ'

c Row 2
+ [K_A] > 'а'
+ [K_S] > 'с'
+ [K_D] > 'д'
+ [K_F] > 'ф'
+ [K_G] > 'г'
+ [K_H] > 'һ'
+ [K_J] > 'ж'
+ [K_K] > 'к'
+ [K_L] > 'л'
